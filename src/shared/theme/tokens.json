{
  "$description": "Message Alarm: design tokens for the 4 selectable themes. Colors are hex (or rgba for translucent surfaces). Sizes are in dp/px (1:1 on a 390-wide reference screen). The theme is chosen by the user in Ajustes > Apariencia and saved locally.",
  "version": "1.0.0",
  "defaultTheme": "indigo",
  "shared": {
    "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 24, "3xl": 32 },
    "screenPaddingX": 20,
    "minTouchTarget": 44,
    "message": { "maxLength": 180 },
    "repeatOptions": ["once", "daily", "weekly"],
    "fontSize": { "caption": 12, "label": 13, "bodySm": 14, "body": 15, "bodyLg": 16, "title": 22, "section": 20 }
  },
  "themes": {
    "indigo": {
      "name": "Índigo",
      "mode": "light",
      "color": {
        "background": "#F4F5F8",
        "surface": "#FFFFFF",
        "surfaceMuted": "#EEEFF4",
        "surfaceInverse": "#14162B",
        "surfaceInverseRaised": "#1F2240",
        "text": "#14162B",
        "textMuted": "#5B5E78",
        "textSecondary": "#4A4D66",
        "textOnInverse": "#FFFFFF",
        "textOnInverseMuted": "#C7C9DB",
        "border": "#D9DBE6",
        "divider": "#EEEFF4",
        "primary": "#4338CA",
        "primaryPressed": "#3730A3",
        "onPrimary": "#FFFFFF",
        "primarySoft": "#E8E7FB",
        "highlight": "#F5B83D",
        "onHighlight": "#14162B",
        "success": "#9EE6C0",
        "warningSoft": "#FDF0D5",
        "onWarningSoft": "#8A5A00"
      },
      "font": {
        "display": { "family": "Space Grotesk", "weights": [500, 600, 700] },
        "body": { "family": "Inter", "weights": [400, 500, 600, 700] }
      },
      "clock": { "family": "Space Grotesk", "weight": 600, "sizeHero": 56, "sizeAlarm": 76, "sizeList": 22, "letterSpacing": -1.5 },
      "radius": { "chip": 999, "control": 12, "input": 14, "card": 16, "cardLarge": 20, "hero": 22 },
      "elevation": { "fab": "0 8px 24px rgba(20,22,43,0.22)", "segmentSelected": "0 1px 3px rgba(20,22,43,0.12)" }
    },
    "suizo": {
      "name": "Minimal Suizo",
      "mode": "light",
      "color": {
        "background": "#FFFFFF",
        "surface": "#FFFFFF",
        "text": "#0A0A0A",
        "textMuted": "#555555",
        "rule": "#0A0A0A",
        "hairline": "#D4D4D4",
        "primary": "#0A0A0A",
        "onPrimary": "#FFFFFF",
        "accent": "#FF4D00",
        "$accentUsage": "Indicators only (the 'next / urgent' dot, active markers). Never small text on accent: white on #FF4D00 fails contrast."
      },
      "font": {
        "display": { "family": "Inter Tight", "weights": [800] },
        "body": { "family": "Inter Tight", "weights": [400, 500, 600] }
      },
      "clock": { "family": "Inter Tight", "weight": 800, "sizeHero": 104, "sizeAlarm": 104, "sizeList": 22, "letterSpacing": -6 },
      "radius": { "chip": 0, "control": 0, "input": 0, "card": 0, "cardLarge": 0, "hero": 0 },
      "border": { "strong": "1px solid #0A0A0A", "hairline": "1px solid #D4D4D4" },
      "textTransform": { "labels": "uppercase" },
      "elevation": "none"
    },
    "cristal": {
      "name": "Cristal nocturno",
      "mode": "dark",
      "color": {
        "background": "#0B1026",
        "backgroundGlowA": "#3B2D8F",
        "backgroundGlowB": "#0E6E8C",
        "glass": "rgba(255,255,255,0.08)",
        "glassStrong": "rgba(255,255,255,0.18)",
        "glassBorder": "rgba(255,255,255,0.18)",
        "text": "#F4F6FF",
        "textMuted": "#C9CEEA",
        "primary": "#5EE6F0",
        "onPrimary": "#0B1026"
      },
      "background": "radial-gradient(circle at 15% 10%, #3B2D8F 0, transparent 45%), radial-gradient(circle at 90% 85%, #0E6E8C 0, transparent 50%), #0B1026",
      "effects": { "glassBlur": 18, "$androidNote": "Real backdrop blur needs Android 12+ (RenderEffect). On older devices use a solid fallback, glass ≈ #1A2040." },
      "font": {
        "display": { "family": "Outfit", "weights": [200, 300] },
        "body": { "family": "Outfit", "weights": [400, 500, 600] }
      },
      "clock": { "family": "Outfit", "weight": 200, "sizeHero": 84, "sizeAlarm": 96, "sizeList": 24, "letterSpacing": -4 },
      "radius": { "chip": 999, "control": 16, "input": 16, "card": 18, "cardLarge": 24, "hero": 24 }
    },
    "bloqueo": {
      "name": "Pantalla de bloqueo",
      "mode": "dark",
      "color": {
        "background": "#0C0A11",
        "backgroundGlow": "rgba(255,94,138,0.28)",
        "frost": "rgba(255,255,255,0.10)",
        "frostBorder": "rgba(255,255,255,0.12)",
        "text": "#F5F3F8",
        "textMuted": "#C9C3D3",
        "primary": "#F5F3F8",
        "onPrimary": "#0C0A11"
      },
      "gradients": {
        "$usage": "Applied to the big clock numbers (text gradient), the app icon in notifications and the selected segment. The user picks one in Ajustes > Apariencia; default 'atardecer'. Direction: top to bottom (180deg).",
        "atardecer": { "name": "Atardecer", "stops": ["#FFC36B", "#FF6B8B", "#9B6BFF"] },
        "aurora": { "name": "Aurora", "stops": ["#7CF5C8", "#3FB7FF", "#6B5BFF"] },
        "fuego": { "name": "Fuego", "stops": ["#FFE27A", "#FF9F45", "#FF4F5E"] },
        "plata": { "name": "Plata", "stops": ["#F5F3F8", "#C9C3D3", "#8E879C"] }
      },
      "effects": { "frostBlur": 20, "$androidNote": "Same as cristal: blur on Android 12+, solid fallback ≈ #221E2A." },
      "font": {
        "display": { "family": "Nunito", "weights": [800, 900] },
        "body": { "family": "Inter", "weights": [400, 500, 600, 700] }
      },
      "clock": { "family": "Nunito", "weight": 900, "sizeHero": 118, "sizeAlarm": 118, "sizeList": 20, "letterSpacing": -4 },
      "radius": { "chip": 999, "control": 999, "input": 20, "card": 24, "cardLarge": 24, "hero": 24 }
    }
  }
}
